<Window x:Class="PitchDetectorApp.VocalTrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PitchDetectorApp"
        mc:Ignorable="d"
        Title="Entrenador Vocal Progresivo" Height="470" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Selección de Tesitura -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Selecciona tu tipo de voz (Tesitura):" FontSize="13" Foreground="#A0A5B1" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbVoiceType" Height="36" FontSize="14" FontWeight="SemiBold"
                      DisplayMemberPath="DisplayName" SelectionChanged="CmbVoiceType_SelectionChanged"/>
        </StackPanel>

        <!-- 2. Nota Objetivo vs Nota Cantada -->
        <Border Grid.Row="1" Background="#252830" BorderBrush="#353A45" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="NOTA OBJETIVO" FontSize="11" FontWeight="Bold" Foreground="#A0A5B1" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTargetNote" Text="C3" FontSize="50" FontWeight="Bold"
                               Foreground="#4CC2FF" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                    <Button x:Name="BtnPlayNote" Content="🔊 Escuchar nota" Padding="10,4" FontSize="12"
                            FontWeight="SemiBold" Background="#323846" Foreground="#4CC2FF"
                            BorderThickness="0" Click="BtnPlayNote_Click" Cursor="Hand"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="#353A45" Margin="8,10"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="TU VOZ ACTUAL" FontSize="11" FontWeight="Bold" Foreground="#A0A5B1" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetectedNote" Text="--" FontSize="26" FontWeight="Bold"
                               Foreground="#E0E6ED" HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Barra de retención e instrucción -->
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <ProgressBar x:Name="PrgHold" Height="14" Minimum="0" Maximum="100" Value="0"
                         Background="#2A2D34" Foreground="#4CAF50" BorderThickness="0"/>
            <TextBlock x:Name="TxtInstruction" Text="Presiona Iniciar y canta la nota objetivo"
                       FontSize="15" FontWeight="SemiBold" Foreground="#E0E6ED"
                       HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center"/>
        </StackPanel>

        <!-- 4. Botones de Control -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnStartStop" Grid.Column="0" Content="Iniciar Entrenamiento" Height="44"
                    FontSize="15" FontWeight="SemiBold" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Click="BtnStartStop_Click" Cursor="Hand"/>

            <Button x:Name="BtnReset" Grid.Column="2" Content="Reiniciar" Height="44"
                    FontSize="14" FontWeight="SemiBold" Background="#3A3F4B" Foreground="White"
                    BorderThickness="0" Click="BtnReset_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
