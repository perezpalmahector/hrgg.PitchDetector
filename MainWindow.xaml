<Window x:Class="PitchDetectorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PitchDetectorApp"
        mc:Ignorable="d"
        Title="Afinador YIN Profesional" Height="320" Width="400"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="White"
        >
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtNota" Text="--" FontSize="76" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#4CC2FF"/>
            <TextBlock x:Name="TxtDetalle" Text="Presiona Activar para escuchar" FontSize="16"
                       HorizontalAlignment="Center" Foreground="#AAAAAA" Margin="0,8,0,0"/>
        </StackPanel>

        <Button x:Name="BtnToggle" Grid.Row="1" Content="Activar" Height="45" FontSize="16"
                FontWeight="SemiBold" Background="#2E7D32" Foreground="White"
                BorderThickness="0" Click="BtnToggle_Click" Cursor="Hand"/>
    </Grid>
</Window>