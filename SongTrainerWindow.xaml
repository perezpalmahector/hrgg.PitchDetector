<Window x:Class="PitchDetectorApp.SongTrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PitchDetectorApp"
        mc:Ignorable="d"
        Title="Ensayador de Cantos Línea a Línea" Height="610" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Canto:" FontSize="12" Foreground="#A0A5B1" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbSongs" Height="32" FontSize="13" FontWeight="SemiBold"
                          SelectionChanged="CmbSongs_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Archivo:" FontSize="12" Foreground="#A0A5B1" Margin="0,0,0,4"/>
                <Button x:Name="BtnLoadJson" Content="📂 JSON" Height="32" Padding="12,0"
                        FontSize="12" FontWeight="SemiBold" Background="#323846" Foreground="#4CC2FF"
                        BorderThickness="0" Click="BtnLoadJson_Click" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Voz / Octava:" FontSize="12" Foreground="#A0A5B1" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbOctave" Width="140" Height="32" SelectedIndex="0"
                          SelectionChanged="CmbOctave_SelectionChanged">
                    <ComboBoxItem Content="👩 Aguda (Octava 4)" Tag="4"/>
                    <ComboBoxItem Content="👨 Grave (Octava 3)" Tag="3"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Línea del canto:" FontSize="12" Foreground="#A0A5B1" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbLines" Height="34" FontSize="13"
                          SelectionChanged="CmbLines_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <TextBlock x:Name="TxtDurationLabel" Text="Duración nota: 0.50s" FontSize="12" Foreground="#E0E6ED" HorizontalAlignment="Center"/>
                <Slider x:Name="SldDuration" Minimum="0.25" Maximum="1.50" Value="0.50" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" ValueChanged="SldDuration_ValueChanged" Margin="0,4,0,2"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="#252830" BorderBrush="#353A45" BorderThickness="1"
                CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtSectionBadge" Grid.Row="0" Text="ESTROFA 1" FontSize="11"
                           FontWeight="Bold" Foreground="#81C784"/>

                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                    <TextBlock x:Name="TxtChords" Text=" " FontFamily="Consolas"
                               FontSize="14" FontWeight="Bold" Foreground="#FFB74D"/>
                    <TextBlock x:Name="TxtLyrics" Text="Carga songs.json para comenzar" FontSize="22"
                               FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <ItemsControl x:Name="LstMelodyNotes" Grid.Row="2" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="2" CornerRadius="8" Padding="12,6" Margin="4">
                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="TxtLivePitch" Grid.Row="3" Text="Tu voz: --" FontSize="15"
                           FontWeight="SemiBold" Foreground="#A0A5B1" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <ProgressBar x:Name="PrgNoteHold" Height="10" Minimum="0" Maximum="100" Value="0"
                         Background="#2A2D34" Foreground="#4CAF50" BorderThickness="0"/>
            <TextBlock x:Name="TxtInstruction" Text="Escucha la melodía de la línea o inicia la práctica"
                       FontSize="14" FontWeight="SemiBold" Foreground="#E0E6ED"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPlayMelody" Grid.Column="0" Content="🔊 Escuchar Línea" Height="44"
                    FontSize="14" FontWeight="SemiBold" Background="#1565C0" Foreground="White"
                    BorderThickness="0" Click="BtnPlayMelody_Click" Cursor="Hand"/>

            <Button x:Name="BtnPractice" Grid.Column="2" Content="🎤 Cantar Línea" Height="44"
                    FontSize="14" FontWeight="SemiBold" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Click="BtnPractice_Click" Cursor="Hand"/>

            <Button x:Name="BtnNextLine" Grid.Column="4" Content="Siguiente ⏭" Padding="16,0" Height="44"
                    FontSize="14" FontWeight="SemiBold" Background="#3A3F4B" Foreground="White"
                    BorderThickness="0" Click="BtnNextLine_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
